# PostGIS for project boundaries + pgvector for the RAG index, one image.
FROM postgis/postgis:15-3.4

RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-15-pgvector \
 && rm -rf /var/lib/apt/lists/*

COPY docker/init-extensions.sql /docker-entrypoint-initdb.d/10-extensions.sql
